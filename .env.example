# Copie este arquivo para .env e troque os valores.
# Gere um segredo forte com:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-no-minimo-32-caracteres
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=12

# Senhas dos usuários de seed (usadas só na criação inicial do database.txt)
SEED_ADMIN_PASSWORD=Admin@123
SEED_USER_PASSWORD=Leitor@123
